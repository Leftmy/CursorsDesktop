<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="using:CursorsDesktop.Views.Components"
             xmlns:vm="using:CursorsDesktop.ViewModels" 
             x:Class="CursorsDesktop.Views.Pages.HomePageView"
             x:DataType="vm:HomePageViewModel">
    
    <Grid RowDefinitions="Auto, *">
        <Border Grid.Row="0" 
                BorderBrush="{DynamicResource TextBrush}" 
                BorderThickness="0,0,0,3"
                Padding="30">
            <TextBlock Text="DISCOVER PACKS" 
                       FontWeight="Black" 
                       FontSize="32" />
        </Border>
        
        <ScrollViewer Grid.Row="1" Padding="30">
    <ItemsControl ItemsSource="{Binding CursorPacks}">
        
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <components:PackCardView />
            </DataTemplate>
        </ItemsControl.ItemTemplate>
        
    </ItemsControl>
</ScrollViewer>
    </Grid>

</UserControl>