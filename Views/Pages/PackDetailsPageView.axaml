<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CursorsDesktop.Views.Pages.PackDetailsPageView">
    
    <Grid RowDefinitions="Auto, *">
        
        <Border Grid.Row="0" 
                BorderBrush="{DynamicResource TextBrush}" 
                BorderThickness="0,0,0,3"
                Padding="30">
            <Grid ColumnDefinitions="Auto, *, Auto">
                
                <Button Grid.Column="0" Classes="brutal" Background="White" Margin="0,0,20,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Classes="icon" Text="&#xf060;"/>
                        <TextBlock Text="BACK" FontWeight="Black"/>
                    </StackPanel>
                </Button>
                
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Minecraft Swords" FontWeight="Black" FontSize="32" />
                    <TextBlock Text="by @misha • 15 cursors" Foreground="Gray" FontSize="16" FontWeight="Bold"/>
                </StackPanel>
                
                <Button Grid.Column="2" Classes="brutal" Background="{DynamicResource PrimaryBrush}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="10,5">
                        <TextBlock Classes="icon" Text="&#xf019;"/>
                        <TextBlock Text="DOWNLOAD PACK" FontWeight="Black" FontSize="18"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
        
        <ScrollViewer Grid.Row="1" Padding="30">
            <WrapPanel Orientation="Horizontal">
                <Border BorderBrush="Black" BorderThickness="3" Background="White" 
                        Width="120" Height="140" Margin="0,0,20,20" BoxShadow="4 4 0 0 Black">
                    <Grid RowDefinitions="*, Auto" Margin="10">
                        <TextBlock Grid.Row="0" Classes="icon" Text="&#xf0245;" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Text="Normal" FontWeight="Bold" HorizontalAlignment="Center" FontSize="12"/>
                    </Grid>
                </Border>

                <Border BorderBrush="Black" BorderThickness="3" Background="White" 
                        Width="120" Height="140" Margin="0,0,20,20" BoxShadow="4 4 0 0 Black">
                    <Grid RowDefinitions="*, Auto" Margin="10">
                        <TextBlock Grid.Row="0" Classes="icon" Text="&#xf0a5;" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Text="Link" FontWeight="Bold" HorizontalAlignment="Center" FontSize="12"/>
                    </Grid>
                </Border>

            </WrapPanel>
        </ScrollViewer>
        
    </Grid>
</UserControl>