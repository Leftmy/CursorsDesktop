<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CursorsDesktop.ViewModels"
    x:DataType="vm:MainViewModel"
    x:Class="CursorsDesktop.Views.Components.SideBarView"
    Background="{DynamicResource PrimaryBrush}">
    
    <Grid RowDefinitions="Auto, *, Auto"
          RowSpacing="15"
          Margin="12">
          
        <Image Grid.Row="0"
               Source="/Assets/Images/senior-cursor-logo.png"
               Margin="0,0,0,20" />
               
        <StackPanel Grid.Row="1" Spacing="15">
            <Button Classes="menu brutal"
                    Classes.active="{Binding IsHomeActive}"
                    Command="{Binding NavigateToHomeCommand}"
                    HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Spacing="15">
                    <TextBlock Classes="icon" Text="&#xf015;" VerticalAlignment="Center"/>
                    <TextBlock Text="HOME" FontWeight="Black" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            
            <Button Classes="menu brutal"
                    Classes.active="{Binding IsMyPacksActive}"
                    Command="{Binding NavigateToMyPacksCommand}"
                    HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
                    <TextBlock Classes="icon" Text="&#xf03d4;"/>
                    <TextBlock Text="MY PACKS" FontWeight="Black"/>
                </StackPanel>
            </Button>
            
            <Button Classes="menu brutal"
                    Classes.active="{Binding IsSettingsActive}"
                    Command="{Binding NavigateToSettingsCommand}"
                    HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
                    <TextBlock Classes="icon" Text="&#xf013;"/>
                    <TextBlock Text="SETTINGS" FontWeight="Black"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Логін / Логаут поки залишаємо як є, їх підв'яжемо до стану авторизації пізніше -->
        <Button Grid.Row="2" Classes="brutal" HorizontalAlignment="Stretch" Background="#FFFFFF" IsVisible="True">
            <StackPanel Orientation="Horizontal" Spacing="15" HorizontalAlignment="Center">
                <TextBlock Classes="icon" Text="&#xf090;" VerticalAlignment="Center"/>
                <TextBlock Text="LOGIN" FontWeight="Black" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
        
        <Button Grid.Row="2" Classes="brutal" HorizontalAlignment="Stretch" Background="#FF4444" IsVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="15" HorizontalAlignment="Center">
                <TextBlock Classes="icon" Text="&#xf05fd;" VerticalAlignment="Center"/>
                <TextBlock Text="LOGOUT" FontWeight="Black" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
    </Grid>
</UserControl>